{
  "name": "yres",
  "private": true,
  "version": "0.1.0",
  "description": "YRES - Yagona Raqamli Energiya Samaradorligi Tizimi (Unified Digital Energy Efficiency System)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "biome format --write .",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate:local": "bun run --cwd apps/api db:migrate:local",
    "db:migrate:prod": "bun run --cwd apps/api db:migrate:prod",
    "deploy:api": "bun run --cwd apps/api deploy",
    "deploy:web": "bun run --cwd apps/web deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  }
}
